# ─── Database (Hostinger: hPanel → Databases → MySQL; host MUST be 127.0.0.1) ───
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME

# ─── Security ───
# APP_SECRET, ADMIN_GATE, SETUP_TOKEN and CRON_KEY are left EMPTY on purpose: until they are filled in,
# the admin (and the cron endpoint) answer 404. Generate each one, never type it by hand:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Template values (change-me…, xxxxxx…) are refused like an empty value.
# 64+ random chars
APP_SECRET=
# Secret path that unlocks the admin (visit https://your-domain/<ADMIN_GATE> once per browser).
# Without it, /admin answers 404 like any unknown page. 8–128 chars of [A-Za-z0-9_-] (use 20+ random
# chars in production); must not be a route name (admin, api, media, fonts, login, setup).
ADMIN_GATE=
# One-time token to create the first owner account at /admin/setup (remove after setup)
SETUP_TOKEN=
# Public base URL (used in exports, emails, canonical links)
PUBLIC_URL=https://your-domain.com
# Recommended: a host name of its own for the admin, e.g. studio.your-domain.com, routed to this same app.
# The gate, /admin and /api/admin then answer only there, and that host serves no landing pages, so the
# pixel scripts on your public pages can never act inside the admin. Unlock it at
# https://<ADMIN_HOST>/<ADMIN_GATE>. Setting or changing it closes the gate for every browser.
# Empty = admin stays on the public domain: then open live pages only in a browser profile with no admin session.
ADMIN_HOST=
# Optional: comma-separated IPs allowed to reach the admin (leave empty to allow all).
# Matched against the address seen by the proxy in front of the app; behind an extra CDN layer it
# cannot see your IP and would block everyone.
ADMIN_IP_ALLOWLIST=
# Proxy hops in front of the app (X-Forwarded-For entry counted from the right). Hostinger: 1.
TRUSTED_PROXY_HOPS=1
# Set to 1 only if the site is behind Cloudflare (then CF-Connecting-IP is trusted).
BEHIND_CLOUDFLARE=0
# Secret for the hPanel cron endpoint /api/cron/tick?key=... (empty = endpoint disabled)
CRON_KEY=

# ─── Google Sheets (service account JSON, base64-encoded on one line) ───
GOOGLE_SA_JSON_B64=
# Optional: key of a SECOND service account, only for PHP exports that include the Google key in
# config.php (docs/GOOGLE-SHEETS-SETUP.md, Part C). COD Studio never ships its own key above: a leaked
# export is stopped by deleting this one in Google Cloud, and the app keeps syncing.
GOOGLE_EXPORT_SA_JSON_B64=

# ─── Optional anti-bot (Cloudflare Turnstile) ───
# Defaults only: keys saved in Admin → Settings → Anti-spam take over. Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional: store time zone (dashboard days, dates written to Google Sheets) ───
# An IANA name such as Europe/Paris. Empty = Africa/Casablanca.
APP_TIMEZONE=
